@implements IAsyncDisposable
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">@_error</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">Skieruj aparat na kod kreskowy.</MudText>
        }
        <video @ref="_video" playsinline muted style="width: 100%; max-height: 60vh; background: #000;"></video>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Anuluj</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BarcodeScannerDialog>? _self;
    private string? _error;
    private bool _closed;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>The code is untrusted input: only short codes of letters, digits, dots and dashes pass.</summary>
    public static bool IsAcceptable(string? code) =>
        !string.IsNullOrEmpty(code) && code.Length <= 50 && code.All(c => char.IsAsciiLetterOrDigit(c) || c is '.' or '-');

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/BarcodeScannerDialog.razor.js");
        if (!await _module.InvokeAsync<bool>("cameraAvailable"))
        {
            _error = "Aparat działa tylko przez połączenie HTTPS, np. przez tunel opisany w README. Kod możesz wpisać ręcznie.";
            StateHasChanged();
            return;
        }

        _self = DotNetObjectReference.Create(this);
        try
        {
            await _module.InvokeVoidAsync("start", _video, _self);
        }
        catch (JSException exception)
        {
            _error = MessageFor(exception.Message);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnDetected(string code)
    {
        if (_closed)
        {
            return;
        }

        if (!IsAcceptable(code))
        {
            _error = "Odczytany kod ma niedozwolone znaki. Spróbuj ponownie albo wpisz go ręcznie.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _closed = true;
        await InvokeAsync(() => Dialog.Close(DialogResult.Ok(code)));
    }

    private static string MessageFor(string error) => error switch
    {
        _ when error.Contains("NotAllowedError", StringComparison.Ordinal) => "Brak zgody na użycie aparatu. Zezwól na dostęp w przeglądarce.",
        _ when error.Contains("NotFoundError", StringComparison.Ordinal) => "Nie znaleziono aparatu w tym urządzeniu.",
        _ when error.Contains("NotReadableError", StringComparison.Ordinal) => "Aparat jest zajęty przez inną aplikację.",
        _ when error.Contains("LibraryError", StringComparison.Ordinal) => "Nie udało się wczytać czytnika kodów.",
        _ => "Nie udało się uruchomić aparatu.",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _video);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the browser released the camera with the page.
            }
        }

        _self?.Dispose();
    }
}
