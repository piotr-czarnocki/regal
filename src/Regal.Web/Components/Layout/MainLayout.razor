@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               aria-label="Menu" OnClick="() => _drawerOpen = !_drawerOpen" />
            </Authorized>
        </AuthorizeView>
        <MudText Typo="Typo.h6">Regał</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3 d-none d-sm-block">@context.User.Identity?.Name@(context.User.IsInRole(Roles.Warehouse) ? " (magazynier)" : null)</MudText>
                @* A native POST: the logout has to clear a cookie, which needs a real HTTP response. *@
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit">Wyloguj</MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always" Elevation="1">
                @* Grouped by the work done; a warehouse worker sees only the warehouse (SPEC 5.19). *@
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All">Pulpit</MudNavLink>
                    <AuthorizeView Roles="@Roles.Administrator" Context="admin">
                        <MudNavGroup Title="Sprzedaż" Expanded="true">
                            <MudNavLink Href="/invoices/new">Nowa faktura</MudNavLink>
                            <MudNavLink Href="/invoices" Match="NavLinkMatch.All">Faktury</MudNavLink>
                            <MudNavLink Href="/orders/new">Nowe zamówienie</MudNavLink>
                            <MudNavLink Href="/orders" Match="NavLinkMatch.All">Zamówienia</MudNavLink>
                        </MudNavGroup>
                    </AuthorizeView>
                    <MudNavGroup Title="Magazyn" Expanded="true">
                        <MudNavLink Href="/stock-documents/new">Nowy dokument</MudNavLink>
                        <MudNavLink Href="/stock-documents" Match="NavLinkMatch.All">Dokumenty magazynowe</MudNavLink>
                        <MudNavLink Href="/stock">Stany magazynowe</MudNavLink>
                        <MudNavLink Href="/stocktakes">Inwentaryzacja</MudNavLink>
                    </MudNavGroup>
                    <AuthorizeView Roles="@Roles.Administrator" Context="admin">
                        <MudNavGroup Title="Analizy">
                            <MudNavLink Href="/analytics/sales">Sprzedaż i marża</MudNavLink>
                            <MudNavLink Href="/analytics/products">Produkty</MudNavLink>
                            <MudNavLink Href="/analytics/abc">Analiza ABC</MudNavLink>
                            <MudNavLink Href="/analytics/slow-moving">Towary zalegające</MudNavLink>
                            <MudNavLink Href="/analytics/customers">Kontrahenci</MudNavLink>
                            <MudNavLink Href="/analytics/forecast">Prognoza zamówień</MudNavLink>
                        </MudNavGroup>
                        <MudNavGroup Title="Kartoteki">
                            <MudNavLink Href="/products">Produkty i usługi</MudNavLink>
                            <MudNavLink Href="/categories">Kategorie</MudNavLink>
                            <MudNavLink Href="/contractors">Kontrahenci</MudNavLink>
                            <MudNavLink Href="/users">Użytkownicy</MudNavLink>
                        </MudNavGroup>
                    </AuthorizeView>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/MainLayout.razor.js");
            await module.InvokeVoidAsync("markInteractive");
        }
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2f5d50",
            AppbarBackground = "#2f5d50",
        },
    };
}
