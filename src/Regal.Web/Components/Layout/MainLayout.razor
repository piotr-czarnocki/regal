@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               aria-label="Menu" OnClick="() => _drawerOpen = !_drawerOpen" />
            </Authorized>
        </AuthorizeView>
        <MudText Typo="Typo.h6">Regał</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3 d-none d-sm-block">@context.User.Identity?.Name</MudText>
                @* A native POST: the logout has to clear a cookie, which needs a real HTTP response. *@
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit">Wyloguj</MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always" Elevation="1">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All">Start</MudNavLink>
                    <MudNavLink Href="/products">Produkty i usługi</MudNavLink>
                    <MudNavLink Href="/categories">Kategorie</MudNavLink>
                    <MudNavLink Href="/contractors">Kontrahenci</MudNavLink>
                    <MudNavLink Href="/stock-documents" Match="NavLinkMatch.All">Dokumenty magazynowe</MudNavLink>
                    <MudNavLink Href="/stock-documents/new">Nowy dokument</MudNavLink>
                    <MudNavLink Href="/stock">Stany magazynowe</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2f5d50",
            AppbarBackground = "#2f5d50",
        },
    };
}
