@page "/invoices"
@inject InvoiceQueries Queries

<PageTitle>Faktury – Regał</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Faktury</MudText>

    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Placeholder="Szukaj: numer, nabywca, NIP" Immediate="true" DebounceInterval="300"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="InvoiceStatus?" Value="_status" ValueChanged="OnStatusChanged" Label="Status">
                <MudSelectItem T="InvoiceStatus?" Value="null">Wszystkie</MudSelectItem>
                @foreach (var status in Enum.GetValues<InvoiceStatus>())
                {
                    <MudSelectItem T="InvoiceStatus?" Value="status">@InvoiceLabels.Status(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker Date="_from" DateChanged="OnFromChanged" Label="Od" Editable="true" Clearable="true" DateFormat="dd.MM.yyyy" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker Date="_to" DateChanged="OnToChanged" Label="Do" Editable="true" Clearable="true" DateFormat="dd.MM.yyyy" />
        </MudItem>
        <MudItem xs="12" md="1" Class="d-flex align-center justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/invoices/new">Nowa</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable @ref="_table" T="InvoiceListItem" ServerData="LoadAsync" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Numer</MudTh>
            <MudTh>Data</MudTh>
            <MudTh>Nabywca</MudTh>
            <MudTh>Brutto</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Numer">
                <MudLink Href="@InvoiceRoutes.Details(context.Id)">@(context.Number ?? "(bez numeru)")</MudLink>
                @if (context.Kind != InvoiceKind.Vat)
                {
                    <MudChip T="string" Size="Size.Small">@InvoiceLabels.Kind(context.Kind)</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Data">@StockLabels.Date(context.IssueDate)</MudTd>
            <MudTd DataLabel="Nabywca">@context.ContractorName</MudTd>
            <MudTd DataLabel="Brutto">@StockLabels.Money(context.GrossTotal)</MudTd>
            <MudTd DataLabel="Status"><InvoiceStatusChip Status="context.Status" /></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>Brak faktur.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager RowsPerPageString="Wierszy:" /></PagerContent>
    </MudTable>
</MudContainer>

@code {
    private MudTable<InvoiceListItem>? _table;
    private string? _search;
    private InvoiceStatus? _status;
    private DateTime? _from;
    private DateTime? _to;

    private static DateOnly? ToDate(DateTime? value) => value is { } date ? DateOnly.FromDateTime(date) : null;

    private async Task<TableData<InvoiceListItem>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        var result = await Queries.SearchAsync(new InvoiceFilter(_status, ToDate(_from), ToDate(_to), _search), state.Page, state.PageSize, cancellationToken);
        return new TableData<InvoiceListItem> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return _table!.ReloadServerData();
    }

    private Task OnStatusChanged(InvoiceStatus? value)
    {
        _status = value;
        return _table!.ReloadServerData();
    }

    private Task OnFromChanged(DateTime? value)
    {
        _from = value;
        return _table!.ReloadServerData();
    }

    private Task OnToChanged(DateTime? value)
    {
        _to = value;
        return _table!.ReloadServerData();
    }
}
