@inject IDialogService Dialogs

@* Deliberately not a <form>: without one, Enter in a field has nothing to submit. *@
<div>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="12" sm="6">
            <MudSelect T="StockDocumentType" Value="_type" ValueChanged="OnTypeChangedAsync" Label="Typ dokumentu">
                @foreach (var type in Enum.GetValues<StockDocumentType>())
                {
                    <MudSelectItem Value="type">@StockLabels.TypeName(type)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        @if (ContractorAllowed)
        {
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="ContractorListItem" Value="_contractor" ValueChanged="OnContractorChanged" SearchFunc="SearchContractorsAsync"
                                 ToStringFunc="c => c?.Name" Label="@(_type == StockDocumentType.PZ ? "Dostawca" : "Odbiorca (opcjonalnie)")"
                                 DebounceInterval="300" ResetValueOnEmptyText="true" CoerceText="true" Clearable="true" />
            </MudItem>
        }
        <MudItem xs="12">
            <MudTextField T="string" Value="_notes" ValueChanged="OnNotesChanged" Label="@(_type == StockDocumentType.RW ? "Powód rozchodu" : "Uwagi")"
                          MaxLength="StockDraftValidator.MaxNotesLength" />
        </MudItem>
        <MudItem xs="12">
            <ProductPicker Search="SearchProducts" FindByCode="FindByCode" Picked="AddProductAsync" />
        </MudItem>
    </MudGrid>

    @foreach (var line in _lines)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-2" @key="line">
            <div class="d-flex align-center">
                <MudText Typo="Typo.subtitle1" Class="flex-grow-1">@line.Product.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Usuń pozycję" Size="Size.Small" OnClick="() => RemoveLine(line)" />
            </div>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal?" Culture="CultureInfo.CurrentCulture" Value="line.Quantity" ValueChanged="value => Changed(() => line.Quantity = value)"
                                     Label="@($"Ilość ({line.Product.Unit})")" Min="0" HideSpinButtons="true" />
                </MudItem>
                @if (IsReceipt)
                {
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal?" Culture="CultureInfo.CurrentCulture" Value="line.UnitCost" ValueChanged="value => Changed(() => line.UnitCost = value)" Min="0" HideSpinButtons="true"
                                         Label="@(_type == StockDocumentType.PZ ? "Cena zakupu (zł)" : "Koszt (zł)")"
                                         HelperText="@(_type == StockDocumentType.PW ? $"Puste: średnia {StockLabels.Cost(line.Product.AverageCost)}" : null)" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" Value="line.BatchNumber" ValueChanged="value => Changed(() => line.BatchNumber = value)" Label="Numer partii"
                                      HelperText="Puste: numer dokumentu" MaxLength="StockDraftValidator.MaxBatchNumberLength" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudDatePicker Date="line.ExpiryDate" DateChanged="value => Changed(() => line.ExpiryDate = value)" Editable="true" Clearable="true" DateFormat="dd.MM.yyyy"
                                       Label="@(line.Product.HasExpiry ? "Data ważności" : "Data ważności (opcjonalnie)")" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="9">
                        <MudSelect T="int?" Value="line.BatchId" ValueChanged="value => Changed(() => line.BatchId = value)" Label="Partia">
                            <MudSelectItem T="int?" Value="null">Automatycznie: najkrótsza data ważności</MudSelectItem>
                            @foreach (var batch in line.Batches)
                            {
                                <MudSelectItem T="int?" Value="batch.BatchId" Disabled="@(batch.IsExpired && _type == StockDocumentType.WZ)">
                                    @BatchLabel(batch, line.Product.Unit)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    @if (_preview is not null)
    {
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Podgląd</MudText>
        <MudTable T="PreviewRow" Items="_preview" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true">
            <HeaderContent>
                <MudTh>Produkt</MudTh>
                <MudTh>Partia</MudTh>
                <MudTh>Data ważności</MudTh>
                <MudTh>Ilość</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Produkt">@context.ProductName</MudTd>
                @if (context.Error is not null)
                {
                    <MudTd DataLabel="Problem" colspan="3"><MudText Typo="Typo.body2" Color="Color.Error">@context.Error</MudText></MudTd>
                }
                else
                {
                    <MudTd DataLabel="Partia">@context.Batch</MudTd>
                    <MudTd DataLabel="Data ważności">@StockLabels.Date(context.ExpiryDate)</MudTd>
                    <MudTd DataLabel="Ilość">@StockLabels.Quantity(context.Quantity)</MudTd>
                }
            </RowTemplate>
        </MudTable>
    }

    <div class="d-flex justify-end flex-wrap gap-2 mt-4">
        <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" Color="Color.Primary" OnClick="PreviewAsync"
                   Disabled="@(_lines.Count == 0 || _busy)">Pokaż podgląd</MudButton>
        <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary" OnClick="ApproveAsync"
                   Disabled="@(!CanApprove)">Zatwierdź</MudButton>
    </div>
</div>

@code {
    private sealed class Line(ProductPick product)
    {
        public ProductPick Product { get; } = product;
        public decimal? Quantity { get; set; } = 1;
        public decimal? UnitCost { get; set; }
        public string? BatchNumber { get; set; }
        public DateTime? ExpiryDate { get; set; }
        public int? BatchId { get; set; }
        public IReadOnlyList<StockBatchRow> Batches { get; set; } = [];
    }

    private sealed record PreviewRow(string ProductName, string? Batch, DateOnly? ExpiryDate, decimal Quantity, string? Error);

    // Kept across attempts: if a send's reply is lost, sending again cannot create a second document.
    private readonly Guid _requestId = Guid.NewGuid();
    private readonly List<Line> _lines = [];
    private StockDocumentType _type;
    private ContractorListItem? _contractor;
    private string? _notes;
    private string? _error;
    private IReadOnlyList<PreviewRow>? _preview;
    private bool _busy;

    [Parameter]
    public StockDocumentType InitialType { get; set; } = StockDocumentType.PZ;

    [Parameter, EditorRequired]
    public Func<string, CancellationToken, Task<IReadOnlyList<ProductPick>>> SearchProducts { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<string, CancellationToken, Task<ProductPick?>> FindByCode { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<int, Task<IReadOnlyList<StockBatchRow>>> LoadBatches { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<string?, CancellationToken, Task<IReadOnlyList<ContractorListItem>>> SearchContractors { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<StockDocumentDraft, Task<IReadOnlyList<IssuePreviewLine>>> PreviewIssue { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<StockDocumentDraft, Task<SaveResult>> Post { get; set; } = null!;

    /// <summary>Receives the id of the approved document.</summary>
    [Parameter, EditorRequired]
    public EventCallback<int> Posted { get; set; }

    private bool IsReceipt => _type.IsReceipt();

    private bool ContractorAllowed => _type is StockDocumentType.PZ or StockDocumentType.WZ;

    private bool CanApprove => !_busy && _preview is not null && _preview.All(row => row.Error is null);

    protected override void OnInitialized() => _type = InitialType;

    private static string BatchLabel(StockBatchRow batch, string unit)
    {
        var expired = batch.IsExpired ? " (przeterminowana)" : string.Empty;
        return $"{batch.Number} · ważna do {StockLabels.Date(batch.ExpiryDate)} · {StockLabels.Quantity(batch.Quantity)} {unit}{expired}";
    }

    private void Changed(Action apply)
    {
        apply();
        _preview = null;
        _error = null;
    }

    private void OnContractorChanged(ContractorListItem? contractor) => Changed(() => _contractor = contractor);

    private void OnNotesChanged(string? notes) => Changed(() => _notes = notes);

    private void RemoveLine(Line line) => Changed(() => _lines.Remove(line));

    private async Task OnTypeChangedAsync(StockDocumentType type)
    {
        Changed(() => _type = type);
        if (!ContractorAllowed)
        {
            _contractor = null;
        }

        if (!IsReceipt)
        {
            foreach (var line in _lines)
            {
                line.BatchId = null;
                line.Batches = await LoadBatches(line.Product.Id);
            }
        }
    }

    private async Task<IEnumerable<ContractorListItem>> SearchContractorsAsync(string? term, CancellationToken cancellationToken) =>
        await SearchContractors(term, cancellationToken);

    /// <summary>A product already on the document gets one more unit, so scanning twice means two pieces.</summary>
    private async Task AddProductAsync(ProductPick product)
    {
        var existing = _lines.LastOrDefault(line => line.Product.Id == product.Id);
        if (existing is not null)
        {
            Changed(() => existing.Quantity = (existing.Quantity ?? 0) + 1);
            return;
        }

        var line = new Line(product);
        Changed(() => _lines.Add(line));
        if (!IsReceipt)
        {
            line.Batches = await LoadBatches(product.Id);
        }
    }

    private StockDocumentDraft BuildDraft() => new()
    {
        RequestId = _requestId,
        Type = _type,
        ContractorId = _contractor?.Id,
        Notes = _notes,
        Lines = _lines.Select(line => new StockDocumentLine
        {
            ProductId = line.Product.Id,
            Quantity = line.Quantity ?? 0,
            UnitCost = line.UnitCost,
            BatchNumber = line.BatchNumber,
            ExpiryDate = line.ExpiryDate is { } date ? DateOnly.FromDateTime(date) : null,
            BatchId = line.BatchId,
        }).ToList(),
    };

    private async Task PreviewAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        _preview = null;
        try
        {
            var draft = BuildDraft();
            _error = StockDraftValidator.Validate(draft);
            if (_error is null)
            {
                _preview = IsReceipt ? ReceiptPreview() : IssueRows(await PreviewIssue(draft));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private List<PreviewRow> ReceiptPreview() => _lines
        .Select(line => new PreviewRow(
            line.Product.Name,
            BatchNumbers.Normalize(line.BatchNumber) ?? "numer dokumentu",
            line.ExpiryDate is { } date ? DateOnly.FromDateTime(date) : null,
            line.Quantity ?? 0,
            StockDraftValidator.ValidateQuantity(line.Quantity ?? 0, line.Product.Unit)))
        .ToList();

    private static List<PreviewRow> IssueRows(IReadOnlyList<IssuePreviewLine> lines) => lines
        .SelectMany(line => line.Error is not null
            ? [new PreviewRow(line.ProductName, null, null, 0, line.Error)]
            : line.Allocations.Select(a => new PreviewRow(line.ProductName, a.Batch.Number, a.Batch.ExpiryDate, a.Quantity, null)))
        .ToList();

    private async Task ApproveAsync()
    {
        // Set before the first await: events of one circuit run one at a time, so a second
        // click is handled only after this line has run and is ignored.
        if (!CanApprove)
        {
            return;
        }

        _busy = true;
        var posted = false;
        try
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                "Zatwierdzić dokument?",
                "Zatwierdzonego dokumentu nie można zmienić ani usunąć. Błąd poprawia się korektą.",
                yesText: "Zatwierdź",
                cancelText: "Wróć");
            if (confirmed != true)
            {
                return;
            }

            var result = await Post(BuildDraft());
            if (result.IsSuccess)
            {
                posted = true;
                await Posted.InvokeAsync(result.Id!.Value);
            }
            else
            {
                _error = result.Error;
                _preview = null; // stock may have moved on, so what was shown no longer holds
            }
        }
        finally
        {
            // Stays set after success, so nothing can post again on the way to the next page.
            _busy = posted;
        }
    }
}
