@implements IDisposable

@* data-settled counts the times the picker finished adding and gave the focus back.
   Browser tests wait for it before typing elsewhere (tests/Regal.E2ETests/Ui.cs). *@
<div class="d-flex align-start gap-1 product-picker" data-settled="@_settled">
    <MudTextField @ref="_field" T="string" Value="_text" ValueChanged="OnTextChanged" Immediate="true" OnKeyDown="OnKeyDownAsync"
                  Label="Dodaj produkt: nazwa, SKU lub EAN" HelperText="Zeskanuj kod albo wpisz go i naciśnij Enter." Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.QrCodeScanner" autocomplete="off" Class="flex-grow-1" />
    <ScanButton Scanned="OnScanned" Class="mt-2" />
</div>

@foreach (var error in _errors)
{
    <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-1" role="alert">@error</MudText>
}

@if (_results.Count > 0)
{
    <MudPaper Outlined="true" Class="mt-1">
        <MudList T="int" Dense="true">
            @foreach (var product in _results)
            {
                <MudListItem T="int" Value="product.Id" OnClick="() => PickAsync(product)"
                             Text="@product.Name" SecondaryText="@($"{product.Sku} · {product.Ean}")" />
            }
        </MudList>
    </MudPaper>
}

@code {
    private const int SearchDelayMilliseconds = 250;
    private const int MinSearchLength = 2;

    private readonly Queue<string> _scans = new();
    private readonly List<string> _errors = [];
    private MudTextField<string>? _field;
    private CancellationTokenSource? _pendingSearch;
    private string? _text;
    private IReadOnlyList<ProductPick> _results = [];
    private bool _resolving;
    private bool _selectTextAfterRender;

    // Raised after the focus call has completed, with no await before the handler ends, so the
    // first render showing the new value comes after the browser has moved the focus back.
    // Without it a browser test could type into the next field while the focus call was still
    // on its way and see its text land in this field (docs/przygody.md).
    private int _settled;

    [Parameter, EditorRequired]
    public Func<string, CancellationToken, Task<IReadOnlyList<ProductPick>>> Search { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<string, CancellationToken, Task<ProductPick?>> FindByCode { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback<ProductPick> Picked { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After the render, because the text has to be in the browser before it can be selected.
        if (_selectTextAfterRender)
        {
            _selectTextAfterRender = false;
            await _field!.SelectAsync();
        }
    }

    private async Task OnTextChanged(string? value)
    {
        if (value == _text)
        {
            return; // this component changed the field itself
        }

        _text = value;
        if (!_resolving)
        {
            _errors.Clear();
        }

        CancelSearch();

        var term = value?.Trim();
        if (term is null || term.Length < MinSearchLength)
        {
            _results = [];
            return;
        }

        var pending = _pendingSearch = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDelayMilliseconds, pending.Token);
            _results = await Search(term, pending.Token);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke or an Enter replaced this search.
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SubmitAsync(_text);
        }
    }

    /// <summary>A code from the camera goes the same way as one typed and confirmed with Enter.</summary>
    private Task OnScanned(string code) => SubmitAsync(code);

    private async Task SubmitAsync(string? value)
    {
        CancelSearch();
        var text = value?.Trim();
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        _scans.Enqueue(text);
        if (_resolving)
        {
            await EmptyFieldAsync(); // the loop below, still running, will take this scan
            return;
        }

        // One at a time and in order, so fast scans cannot overtake each other.
        _resolving = true;
        _errors.Clear();
        try
        {
            // Emptied before the lookup, so the next scan starts in a free field.
            await EmptyFieldAsync();
            do
            {
                while (_scans.TryDequeue(out var scan))
                {
                    await ResolveAsync(scan);
                }

                await _field!.FocusAsync();
            }
            while (_scans.Count > 0); // a scan can arrive during the focus call, while this loop still owns the queue

            _settled++;
        }
        finally
        {
            _resolving = false;
        }
    }

    /// <summary>Exact EAN or SKU first; only without one does the text count as a fragment.</summary>
    private async Task ResolveAsync(string text)
    {
        var exact = await FindByCode(text, CancellationToken.None);
        if (exact is not null)
        {
            if (exact.CanBeAdded)
            {
                await Picked.InvokeAsync(exact);
            }
            else
            {
                await ReportNotFoundAsync(text);
            }

            return;
        }

        var matches = await Search(text, CancellationToken.None);
        switch (matches.Count)
        {
            case 0:
                await ReportNotFoundAsync(text);
                break;
            case 1:
                await Picked.InvokeAsync(matches[0]);
                break;
            default:
                _results = matches;
                await ReturnTextToFieldAsync(text);
                break;
        }
    }

    private Task ReportNotFoundAsync(string text)
    {
        _errors.Add($"Nie znaleziono produktu o kodzie {text}");
        return ReturnTextToFieldAsync(text);
    }

    /// <summary>Selected, so the next scan replaces it. Left alone when the next scan has already begun.</summary>
    private async Task ReturnTextToFieldAsync(string text)
    {
        if (_scans.Count > 0 || !string.IsNullOrEmpty(_text))
        {
            return;
        }

        _text = text;
        _selectTextAfterRender = true;
        await _field!.SetTextAsync(text);
    }

    private async Task PickAsync(ProductPick product)
    {
        CancelSearch();
        _errors.Clear();
        await EmptyFieldAsync();
        await Picked.InvokeAsync(product);
        await _field!.FocusAsync();
        _settled++;
    }

    private async Task EmptyFieldAsync()
    {
        _text = null;
        _results = [];
        await _field!.ClearAsync();
    }

    private void CancelSearch()
    {
        _pendingSearch?.Cancel();
        _pendingSearch?.Dispose();
        _pendingSearch = null;
    }

    public void Dispose() => CancelSearch();
}
